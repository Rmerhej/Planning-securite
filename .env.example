# PlanSécu — configuration de production
# 1. Copier ce fichier :      cp .env.example .env
# 2. Remplir les valeurs :    nano .env
# 3. Protéger le fichier :    chmod 600 .env
# Ne jamais envoyer ce fichier sur GitHub ni par email.

# Fichier Docker utilisé par « docker compose » sur le serveur (ne pas toucher)
COMPOSE_FILE=docker-compose.prod.yml

# Cas B du guide uniquement (proxy dans Docker) : nom du réseau Docker du proxy, ex. fle-presence_default.
# Le script deploy/connecter-proxy.sh y branche plansecu-app (appelé automatiquement par mise-a-jour.sh).
PROXY_NETWORK=

# Instance de démonstration publique (facultative) : décommenter les 3 lignes pour l'activer.
# COMPOSE_PROFILES=demo
# DEMO_BASE_URL=https://demo-planning-securite.duckdns.org
# DEMO_URL=https://demo-planning-securite.duckdns.org

# Adresse publique de l'appli (utilisée dans les QR codes, SMS et emails)
APP_BASE_URL=https://planning.ton-domaine.fr

# Port local sur lequel le proxy (nginx, Caddy…) joint l'appli. Changer si 8081 est déjà pris.
APP_PORT=8081

# Base de données : mettre des mots de passe longs et différents (ex. générés avec : openssl rand -base64 24)
DB_PASSWORD=a-remplacer
MYSQL_ROOT_PASSWORD=a-remplacer-aussi

# Compte administrateur créé au premier démarrage (changeable ensuite dans « Mon compte »)
ADMIN_USER=admin
ADMIN_PASSWORD=a-remplacer

# Emails (laisser MAIL_ENABLED=false tant que ce n'est pas configuré : les envois sont simulés)
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=planning@ton-domaine.fr

# SMS : log (simulé) ou brevo
SMS_PROVIDER=log
BREVO_API_KEY=
SMS_SENDER=PlanSecu
